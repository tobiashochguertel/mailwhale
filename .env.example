# MailWhale dev environment — copy to .env and fill in
MW_SMTP_HOST=smtp.example.com
MW_SMTP_PORT=587
MW_SMTP_USER=
MW_SMTP_PASS=
MW_SECURITY_PEPPER=dev-pepper-change-in-production

# Container image settings
IMAGE_REGISTRY=docker.registry.hochguertel.work
IMAGE_NAME=mailwhale
IMAGE_TAG=latest

# Registry authentication (used by podman login --password-stdin)
REGISTRY_USERNAME=tobias.hochguertel
REGISTRY_PASSWORD=
